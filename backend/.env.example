# AeroMesh Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database
# Use PostgreSQL if available, otherwise sqlite:///./aeromesh.db will be used as fallback
DATABASE_URL=sqlite:///./aeromesh.db

# Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SESSION_SECRET=aeromesh-super-secret-session-key-2026-production-ready
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_PATH=./storage

# AI Models & CV
YOLO_MODEL=yolov8n.pt
ENABLE_GPU=false
COLMAP_PATH=auto
MAX_RECONSTRUCTION_KEYFRAMES=30
